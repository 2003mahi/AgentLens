# ==============================================================================
# AI Agent Evaluation Platform - Environment Variables Template
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# Application & API Settings
PROJECT_NAME="AI Agent Evaluation Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="production"  # Options: development, staging, production
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"

# Database Configuration
# For local SQLite (Default development):
# DATABASE_URL="sqlite:///./evaluation_platform.db"
#
# For PostgreSQL (Docker / Production / Supabase):
DATABASE_URL="postgresql://postgres:postgres@db:5432/postgres"


# Supabase (Optional - if using Supabase managed backend)

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key-here"
SUPABASE_SECRET_KEY="your-supabase-secret-key-here"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"

# Model Providers & LLM Judge (Optional - for live LLM adapters and LLM Judge)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Frontend Configuration
# Target API origin for production frontend (if not using same-domain reverse proxy)
VITE_API_URL="http://localhost:8000"
